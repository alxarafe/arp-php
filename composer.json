{
  "name": "alxarafe/arp-php",
  "description": "Infrastructure-independent ARP scalar dictionary",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.5",
    "symfony/yaml": "^7.4"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Alxarafe\\Arp\\Dictionary\\": "src/",
      "Alxarafe\\Arp\\Cds\\Physical\\": [
        "src/Cds/Physical/",
        "providers/mariadb/src/",
        "providers/mysql/src/",
        "providers/postgresql/src/",
        "providers/sqlserver/src/"
      ],
      "Alxarafe\\Arp\\Sql\\": "providers/sql/src/",
      "Alxarafe\\Arp\\MariaDb\\": "providers/mariadb/src/",
      "Alxarafe\\Arp\\MySql\\": "providers/mysql/src/",
      "Alxarafe\\Arp\\PostgreSql\\": "providers/postgresql/src/",
      "Alxarafe\\Arp\\SqlServer\\": "providers/sqlserver/src/"
    }
  },
  "scripts": {
    "test": [
      "@test:conformance",
      "@test:runtime",
      "@test:cds-read",
      "@test:listget",
      "@test:crud",
      "@test:integer"
    ],
    "test:conformance": "@php tests/conformance.php",
    "test:runtime": "@php tests/runtime.php",
    "test:structure": "bash tests/structure.sh",
    "test:cds-read": "@php tests/cds-read.php",
    "test:listget": "@php tests/listget.php",
    "lint": "@php vendor/bin/phpcs",
    "fix": "@php vendor/bin/phpcbf",
    "test:crud": "@php tests/crud.php",
    "test:integer": "@php tests/integer.php"
  }
}